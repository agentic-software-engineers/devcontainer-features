{
  "pinned_version": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "docker-in-docker": {
        "version": "29.9.3",
        "buildxVersion": "0.39.1",
        "composeVersion": "5.7.2"
      }
    }
  },
  "rootless_daemon": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "runArgs": [
      "--security-opt",
      "apparmor=unconfined",
      "--security-opt",
      "seccomp=${localEnv:PWD}/src/docker-in-docker/seccomp.json",
      "--security-opt",
      "systempaths=unconfined",
      "--cap-drop",
      "MKNOD",
      "--cap-drop",
      "NET_RAW",
      "--cap-drop",
      "AUDIT_WRITE",
      "--device",
      "/dev/net/tun"
    ],
    "features": {
      "docker-in-docker": {
        "stateDir": "/home/ubuntu/.local/state/docker-in-docker"
      }
    }
  },
  "state_dir": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "docker-in-docker": {
        "stateDir": "/home/ubuntu/.local/state/docker-in-docker"
      }
    }
  }
}
